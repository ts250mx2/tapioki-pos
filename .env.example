DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# Asistente Tapi (IA) — credenciales de HL Console (hl-servidor).
# El proveedor, el modelo y la llave de Anthropic viven en el portal de HL,
# no aqui: esta app corre en MODO PROXY y nunca recibe la llave.
#
# Antes de que Tapi funcione, en HL Console hay que:
#   1. Dar de alta la IP de este servidor en "IPs permitidas".
#   2. Crear la Key de la app en "Keys" (la Key y el Secreto se muestran una sola vez).
#   3. Copiar el UUID del agente Tapi en "Agentes".
#
# HL_URL va con http:// (HL Console sirve HTTP plano) y SIN diagonal final.
HL_URL=
# Key de acceso de esta app (hl_ + 48 hex).
HL_KEY=
# Secreto compartido (64 hex). Solo hace falta en modo llave; en modo proxy se ignora.
HL_SECRET=
# UUID del agente Tapi en el portal.
HL_AGENTE=
# Minutos que se cachea proveedor/modelo antes de volver a preguntarle a HL.
HL_TTL_MIN=30
